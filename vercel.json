{
  "routes": [
    {
      "src": "^/archiv$",
      "status": 308,
      "headers": {
        "Location": "/archiv/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/archiv/(.*)",
      "status": 404,
      "dest": "/archiv/404.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}